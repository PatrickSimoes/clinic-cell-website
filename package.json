{
  "name": "clinic-cell-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site institucional da ClinicCell — assistência técnica de celulares em São José dos Pinhais (PR).",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx && node scripts/prerender.mjs",
    "check": "npm run lint && npm run build && npm run verify",
    "preview": "vite preview",
    "lint": "eslint .",
    "verify": "node scripts/verify-dist.mjs && html-validate dist/index.html dist/404.html",
    "qa": "node scripts/qa-browser.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "fonts:fallbacks": "node scripts/font-fallbacks.mjs",
    "fonts:subset": "python scripts/fonts.py",
    "og:image": "node scripts/og-image.mjs",
    "servicos:ilustracoes": "node scripts/ilustracoes-servicos.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.5.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "node-html-parser": "^9.0.7",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
